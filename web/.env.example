# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://harsha.codes

# Contact form (Resend) — optional; without it, submissions are validated + logged
RESEND_API_KEY=
CONTACT_FROM=Portfolio <onboarding@resend.dev>
CONTACT_TO=harshaygadekar05@gmail.com

# GitHub API (build-time repo list) — optional; raises rate limits
GITHUB_TOKEN=

# Visitor counter durability (Upstash Redis REST) — optional; falls back to memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Writing / blog admin (required to publish from the site)
# Password: min 8 chars. Session secret: min 16 chars (use a long random string).
BLOG_ADMIN_PASSWORD=
BLOG_SESSION_SECRET=
# Posts also persist to content/blog/*.json locally.
# With Upstash configured, posts survive serverless deploys (recommended for Vercel).

# Vercel Blob — production media uploads (images/GIF/video)
# Create a Blob store in Vercel → Storage → Blob, then paste the token.
BLOB_READ_WRITE_TOKEN=
# Local dev falls back to public/uploads/blog without this token.
